DATABASE_URL=mysql+pymysql://packup:packup@127.0.0.1:3306/packup

# local = email/password accounts in MySQL (default) | firebase = Firebase ID tokens
AUTH_MODE=local
# Required for AUTH_MODE=local. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=30

# Only for AUTH_MODE=firebase
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

OPEN_METEO_BASE=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODE=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_ARCHIVE=https://archive-api.open-meteo.com/v1/archive

# Comma-separated list of allowed web origins, e.g. https://packup.example.com
CORS_ORIGINS=*

# Retrain the model in the background every N hours (0 = off)
RETRAIN_INTERVAL_HOURS=24
# Enables /v1/admin/* when set
ADMIN_TOKEN=
